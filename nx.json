{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "affected": {
    "defaultBase": "main"
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "dev": {
      "cache": false
    }
  },
  "generators": {
    "@nx/next": {
      "application": {
        "style": "tailwindcss",
        "linter": "eslint"
      }
    }
  }
}
