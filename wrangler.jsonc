{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perfos-dashboard",
  "pages_build_output_dir": "apps/web/out",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_API_URL": ""
  },
  "env": {
    "preview": {
      "vars": {
        "NEXT_PUBLIC_API_URL": ""
      }
    }
  }
}
