# PerfOS environment — copy to .env and adjust
MOCK_MODE=true
DATABASE_URL=sqlite:///./perfos.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-prod
DEFAULT_WORKSPACE_API_KEY=perfos-demo-key

# Optional read-only public ad-library JSON bridges. Each receives
# ?query=...&country=...&limit=... and may return a list or {items|ads|results|data: []}.
PERFOS_TIKTOK_AD_LIBRARY_URL=
PERFOS_TIKTOK_AD_LIBRARY_TOKEN=
PERFOS_GOOGLE_AD_LIBRARY_URL=
PERFOS_GOOGLE_AD_LIBRARY_TOKEN=
PERFOS_LINKEDIN_AD_LIBRARY_URL=
PERFOS_LINKEDIN_AD_LIBRARY_TOKEN=
PERFOS_X_AD_LIBRARY_URL=
PERFOS_X_AD_LIBRARY_TOKEN=
