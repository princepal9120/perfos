{
  "name": "perfos-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "tsc": "tsc --noEmit",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "gen:openapi": "cd ../api && uv run python scripts/generate_openapi.py",
    "gen:api-types": "openapi-typescript ./openapi.json -o ./lib/api-types.d.ts",
    "gen": "npm run gen:openapi && npm run gen:api-types"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "openapi-typescript": "^6.7.6",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.126.0"
  }
}
