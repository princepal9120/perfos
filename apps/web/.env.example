# PerfOS web — copy to .env.local for local dev.

# FastAPI backend. Leave unset to use http://127.0.0.1:8000/api.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Workspace-scoped routes 401 without this. Matches the backend's
# DEFAULT_WORKSPACE_API_KEY (apps/api/src/app/core/config.py).
NEXT_PUBLIC_API_KEY=perfos-demo-key
